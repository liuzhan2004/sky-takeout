/* ===== 页面基础 ===== */
page {
  height: 100%;
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.cart-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #f7f7f7;
}

/* ===== 顶部操作条 ===== */
.cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 24rpx 30rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f2f2f2;
}

.cart-header-title {
  color: #222222;
  font-size: 30rpx;
  font-weight: 600;
}

.cart-clean-btn {
  color: #9a9a9a;
  font-size: 26rpx;
  padding: 8rpx 16rpx;
}

/* ===== 购物车列表 ===== */
.cart-body {
  flex: 1;
  min-height: 0;
}

.cart-list {
  padding: 20rpx 20rpx 0;
}

.cart-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.item-img-wrap {
  flex-shrink: 0;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
}

.item-img {
  display: block;
  width: 140rpx;
  height: 140rpx;
}

.item-img-empty {
  background: linear-gradient(135deg, #f1f2f3, #e7e8ea);
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item-name {
  color: #222222;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 38rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.item-flavor {
  margin-top: 8rpx;
  color: #9a9a9a;
  font-size: 22rpx;
  line-height: 30rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.item-price {
  margin-top: 10rpx;
  color: #ff3d00;
  font-size: 30rpx;
  font-weight: 700;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ===== 加减步进器 ===== */
.item-stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  box-sizing: border-box;
}

.stepper-minus {
  border: 2rpx solid #c9c9c9;
  color: #666666;
  font-size: 30rpx;
  line-height: 40rpx;
}

.stepper-plus {
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 40rpx;
}

.stepper-num {
  min-width: 56rpx;
  text-align: center;
  color: #333333;
  font-size: 27rpx;
  font-weight: 500;
}

.item-subtotal {
  margin-top: 12rpx;
  color: #222222;
  font-size: 24rpx;
  font-weight: 600;
}

.list-bottom-space {
  height: 180rpx;
}

/* ===== 空购物车 ===== */
.cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 220rpx 40rpx 0;
}

.cart-empty-icon {
  font-size: 120rpx;
  line-height: 130rpx;
}

.cart-empty-text {
  margin-top: 24rpx;
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
}

.cart-empty-tip {
  margin-top: 12rpx;
  color: #9a9a9a;
  font-size: 24rpx;
}

.cart-empty-btn {
  margin-top: 48rpx;
  padding: 18rpx 64rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 140, 0, 0.28);
}

/* ===== 加载失败 ===== */
.load-state {
  padding: 220rpx 40rpx;
  text-align: center;
}

.load-state-title {
  font-size: 30rpx;
  color: #333333;
}

.load-state-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.retry-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 14rpx 56rpx;
  border-radius: 40rpx;
  background-color: #ff8c00;
  color: #ffffff;
  font-size: 26rpx;
}

/* ===== 底部合计栏 ===== */
.settle-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
}

.settle-total {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 92rpx;
  padding: 0 36rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  color: #222222;
}

.settle-total-main {
  display: flex;
  align-items: baseline;
}

.settle-total-tip {
  margin-top: 2rpx;
  color: #9a9a9a;
  font-size: 20rpx;
  line-height: 26rpx;
}

.settle-total-label {
  margin-right: 12rpx;
  font-size: 26rpx;
}

.settle-total-symbol {
  color: #ff3d00;
  font-size: 24rpx;
  font-weight: 600;
}

.settle-total-value {
  color: #ff3d00;
  font-size: 38rpx;
  font-weight: 700;
}

.settle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 140, 0, 0.28);
}

/* ===== 首屏加载 ===== */
.page-loading {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f7f7f7;
}

.page-loading-icon {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #ffe0bd;
  border-top-color: #ff8c00;
  border-radius: 50%;
  animation: loading-rotate 0.8s linear infinite;
}

.page-loading-text {
  margin-top: 24rpx;
  color: #666666;
  font-size: 26rpx;
}

@keyframes loading-rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
