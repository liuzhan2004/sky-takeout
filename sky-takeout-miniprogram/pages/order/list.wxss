/* ===== 页面基础 ===== */
page {
  height: 100%;
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.order-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #f7f7f7;
}

/* ===== 状态标签 ===== */
.tab-bar {
  flex-shrink: 0;
  white-space: nowrap;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f2f2f2;
}

.tab-item {
  display: inline-block;
  padding: 22rpx 28rpx;
  color: #666666;
  font-size: 28rpx;
}

.tab-item-active {
  color: #ff8c00;
  font-weight: 600;
  border-bottom: 4rpx solid #ff8c00;
}

/* ===== 订单列表 ===== */
.order-body {
  flex: 1;
  min-height: 0;
}

.order-card {
  margin: 20rpx 20rpx 0;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-time {
  color: #9a9a9a;
  font-size: 24rpx;
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff8c00;
}

/* 各状态颜色：待付款/待接单橙色，已完成绿色，已取消灰色 */
.order-status-1,
.order-status-2,
.order-status-3,
.order-status-4 {
  color: #ff8c00;
}

.order-status-5 {
  color: #07c160;
}

.order-status-6 {
  color: #999999;
}

.order-dishes {
  margin-top: 18rpx;
  color: #333333;
  font-size: 27rpx;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.order-remark {
  margin-top: 8rpx;
  color: #9a9a9a;
  font-size: 22rpx;
  line-height: 30rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.order-amount-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.order-amount-label {
  color: #666666;
  font-size: 24rpx;
}

.order-amount-symbol {
  margin-left: 8rpx;
  color: #ff3d00;
  font-size: 22rpx;
  font-weight: 600;
}

.order-amount-value {
  color: #ff3d00;
  font-size: 34rpx;
  font-weight: 700;
}

/* ===== 操作按钮 ===== */
.order-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  margin-left: 16rpx;
  padding: 12rpx 32rpx;
  border-radius: 34rpx;
  font-size: 25rpx;
  text-align: center;
}

.action-btn-plain {
  border: 2rpx solid #dddddd;
  color: #555555;
  background-color: #ffffff;
}

.action-btn-primary {
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  color: #ffffff;
  font-weight: 600;
}

/* ===== 加载更多 ===== */
.load-more {
  padding: 24rpx 0 40rpx;
  text-align: center;
  color: #b8b8b8;
  font-size: 24rpx;
}

/* ===== 空列表 ===== */
.order-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx 0;
}

.order-empty-icon {
  font-size: 110rpx;
  line-height: 120rpx;
}

.order-empty-text {
  margin-top: 24rpx;
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
}

.order-empty-tip {
  margin-top: 12rpx;
  color: #9a9a9a;
  font-size: 24rpx;
}

.order-empty-btn {
  margin-top: 48rpx;
  padding: 18rpx 64rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 140, 0, 0.28);
}

/* ===== 加载失败 ===== */
.load-state {
  padding: 160rpx 40rpx;
  text-align: center;
}

.load-state-title {
  font-size: 30rpx;
  color: #333333;
}

.load-state-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.retry-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 14rpx 56rpx;
  border-radius: 40rpx;
  background-color: #ff8c00;
  color: #ffffff;
  font-size: 26rpx;
}
