/* ===== 页面基础 ===== */
page {
  height: 100%;
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.confirm-page {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background-color: #f7f7f7;
}

.confirm-body {
  flex: 1;
  min-height: 0;
  padding-top: 20rpx;
}

/* ===== 卡片区块 ===== */
.section-card {
  margin: 0 20rpx 20rpx;
  padding: 28rpx 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
}

.section-title {
  color: #222222;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* ===== 收货地址 ===== */
.address-line1 {
  display: flex;
  align-items: baseline;
}

.address-name {
  color: #222222;
  font-size: 30rpx;
  font-weight: 600;
}

.address-phone {
  margin-left: 20rpx;
  color: #666666;
  font-size: 26rpx;
}

.address-detail {
  margin-top: 10rpx;
  color: #555555;
  font-size: 26rpx;
  line-height: 38rpx;
}

.address-empty-tip {
  color: #9a9a9a;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

/* ===== 表单 ===== */
.form-input {
  height: 84rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #eeeeee;
  border-radius: 12rpx;
  background-color: #fafafa;
  color: #222222;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-placeholder {
  color: #b8b8b8;
}

.address-save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-disabled {
  opacity: 0.6;
}

/* ===== 商品明细 ===== */
.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-item:last-child {
  border-bottom: none;
}

.item-img {
  display: block;
  flex-shrink: 0;
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
}

.item-img-empty {
  background: linear-gradient(135deg, #f1f2f3, #e7e8ea);
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item-name {
  color: #222222;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 38rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.item-flavor {
  margin-top: 8rpx;
  color: #9a9a9a;
  font-size: 22rpx;
  line-height: 30rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.item-number {
  color: #9a9a9a;
  font-size: 24rpx;
}

.item-subtotal {
  margin-top: 10rpx;
  color: #222222;
  font-size: 26rpx;
  font-weight: 600;
}

/* ===== 备注 ===== */
.remark-input {
  margin-bottom: 0;
}

/* ===== 金额汇总 ===== */
.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.amount-label {
  color: #666666;
  font-size: 26rpx;
}

.amount-value {
  color: #222222;
  font-size: 26rpx;
}

.amount-row-total {
  margin-top: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f2f2f2;
}

.amount-value-total {
  color: #ff3d00;
  font-size: 34rpx;
  font-weight: 700;
}

.list-bottom-space {
  height: 180rpx;
}

/* ===== 底部提交栏 ===== */
.settle-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
}

.settle-total {
  display: flex;
  align-items: baseline;
  height: 92rpx;
  padding: 0 36rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  color: #222222;
}

.settle-total-label {
  margin-right: 12rpx;
  font-size: 26rpx;
}

.settle-total-symbol {
  color: #ff3d00;
  font-size: 24rpx;
  font-weight: 600;
}

.settle-total-value {
  color: #ff3d00;
  font-size: 38rpx;
  font-weight: 700;
}

.settle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 140, 0, 0.28);
}

/* ===== 首屏加载 ===== */
.page-loading {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f7f7f7;
}

.page-loading-icon {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #ffe0bd;
  border-top-color: #ff8c00;
  border-radius: 50%;
  animation: loading-rotate 0.8s linear infinite;
}

.page-loading-text {
  margin-top: 24rpx;
  color: #666666;
  font-size: 26rpx;
}

@keyframes loading-rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* ===== 加载失败 ===== */
.load-state {
  position: fixed;
  left: 0;
  right: 0;
  top: 30%;
  text-align: center;
}

.load-state-title {
  font-size: 30rpx;
  color: #333333;
}

.load-state-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.retry-btn {
  display: inline-block;
  margin-top: 40rpx;
  padding: 14rpx 56rpx;
  border-radius: 40rpx;
  background-color: #ff8c00;
  color: #ffffff;
  font-size: 26rpx;
}
