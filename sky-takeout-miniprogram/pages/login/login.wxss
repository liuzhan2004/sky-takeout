/* ===== 页面基础 ===== */
page {
  height: 100%;
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  min-height: 100vh;
  padding: 200rpx 60rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff7ec 0%, #f7f7f7 100%);
}

/* ===== 品牌区 ===== */
.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  box-shadow: 0 12rpx 28rpx rgba(255, 140, 0, 0.3);
}

.brand-logo-text {
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 700;
}

.brand-name {
  margin-top: 32rpx;
  color: #222222;
  font-size: 44rpx;
  font-weight: 700;
}

.brand-slogan {
  margin-top: 12rpx;
  color: #9a9a9a;
  font-size: 24rpx;
}

/* ===== 登录按钮区 ===== */
.login-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(255, 140, 0, 0.28);
  border: none;
}

.login-btn::after {
  border: none;
}

.login-btn-loading {
  background: linear-gradient(135deg, #c8c8c8, #a8a8a8);
  box-shadow: none;
}

.login-tip {
  margin-top: 24rpx;
  color: #9a9a9a;
  font-size: 24rpx;
}
