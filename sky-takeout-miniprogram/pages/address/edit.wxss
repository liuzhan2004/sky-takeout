/* ===== 页面基础 ===== */
page {
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.edit-page {
  padding: 20rpx;
}

/* ===== 表单卡片 ===== */
.edit-card {
  padding: 8rpx 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.form-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row-default {
  justify-content: space-between;
}

.form-label {
  flex-shrink: 0;
  width: 170rpx;
  color: #333333;
  font-size: 27rpx;
}

.form-input {
  flex: 1;
  color: #222222;
  font-size: 27rpx;
}

.form-placeholder {
  color: #b8b8b8;
}

/* ===== 选项 chip ===== */
.form-options {
  display: flex;
  align-items: center;
}

.option-chip {
  margin-right: 20rpx;
  padding: 10rpx 30rpx;
  border: 2rpx solid #dddddd;
  border-radius: 30rpx;
  color: #555555;
  font-size: 25rpx;
}

.option-chip-active {
  border-color: #ff8c00;
  color: #ff8c00;
  background-color: #fff7ec;
  font-weight: 600;
}

/* ===== 保存按钮 ===== */
.save-bar {
  margin-top: 48rpx;
  padding: 0 4rpx calc(env(safe-area-inset-bottom));
}

.save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(255, 140, 0, 0.28);
}

.save-btn-disabled {
  opacity: 0.6;
}
