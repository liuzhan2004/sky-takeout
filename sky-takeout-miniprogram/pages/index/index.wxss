/* ===== 页面基础 ===== */
page {
  height: 100%;
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.index-page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff7ec 0%, #fff7ec 340rpx, #f7f7f7 340rpx, #f7f7f7 100%);
}

/* ===== 店铺状态卡片 ===== */
.shop-card {
  padding: 30rpx 24rpx 0;
}

.shop-card-inner {
  padding: 44rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  box-shadow: 0 12rpx 30rpx rgba(255, 140, 0, 0.24);
  color: #ffffff;
}

.shop-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.shop-name {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 52rpx;
}

.shop-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.badge-open {
  background: rgba(255, 255, 255, 0.24);
  color: #ffffff;
}

.badge-closed {
  background: rgba(0, 0, 0, 0.24);
  color: rgba(255, 255, 255, 0.9);
}

.shop-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.shop-action {
  display: inline-flex;
  align-items: center;
  margin-top: 40rpx;
  padding: 18rpx 36rpx;
  border-radius: 40rpx;
  background-color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(180, 90, 0, 0.18);
}

.shop-action-text {
  color: #ff8c00;
  font-size: 28rpx;
  font-weight: 600;
}

.shop-action-arrow {
  margin-left: 10rpx;
  color: #ff8c00;
  font-size: 30rpx;
  font-weight: 700;
}

.shop-action-disabled {
  background: rgba(255, 255, 255, 0.28);
  box-shadow: none;
}

.shop-action-disabled .shop-action-text {
  color: rgba(255, 255, 255, 0.9);
}

.shop-action-unknown {
  background: rgba(255, 255, 255, 0.9);
}

/* ===== 快捷入口 ===== */
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx 24rpx 0;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 50%;
  padding: 40rpx 0 32rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f2f2f2;
}

/* 每行第 1、3 个加右侧分隔线 */
.entry-item:nth-child(odd) {
  border-right: 1rpx solid #f2f2f2;
}

/* 最后一行去掉底部分隔线 */
.entry-item:nth-last-child(1),
.entry-item:nth-last-child(2) {
  border-bottom: none;
}

.entry-icon {
  font-size: 52rpx;
  line-height: 64rpx;
}

.entry-name {
  margin-top: 14rpx;
  color: #222222;
  font-size: 28rpx;
  font-weight: 600;
}

.entry-desc {
  margin-top: 6rpx;
  color: #9a9a9a;
  font-size: 22rpx;
}

/* ===== 服务承诺 ===== */
.promise-card {
  margin: 24rpx 24rpx 0;
  padding: 36rpx 0;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.promise-title {
  text-align: center;
  color: #666666;
  font-size: 24rpx;
}

.promise-list {
  display: flex;
  justify-content: space-around;
  margin-top: 28rpx;
}

.promise-item {
  color: #222222;
  font-size: 26rpx;
  font-weight: 500;
}

/* ===== 首屏加载 ===== */
.page-loading {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f7f7f7;
}

.page-loading-icon {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #ffe0bd;
  border-top-color: #ff8c00;
  border-radius: 50%;
  animation: loading-rotate 0.8s linear infinite;
}

.page-loading-text {
  margin-top: 24rpx;
  color: #666666;
  font-size: 26rpx;
}

@keyframes loading-rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
