/* ===== 页面基础 ===== */
page {
  height: 100%;
  background-color: #f7f7f7;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.my-page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff7ec 0%, #fff7ec 300rpx, #f7f7f7 300rpx, #f7f7f7 100%);
}

/* ===== 用户信息卡片 ===== */
.user-card {
  display: flex;
  align-items: center;
  margin: 30rpx 24rpx 0;
  padding: 36rpx 32rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.user-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  box-shadow: 0 6rpx 16rpx rgba(255, 140, 0, 0.24);
}

.user-avatar-text {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
}

.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.user-name {
  color: #222222;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.user-openid {
  margin-top: 8rpx;
  color: #9a9a9a;
  font-size: 22rpx;
  word-break: break-all;
}

.user-login-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 14rpx 36rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ffb13d 0%, #ff8c00 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

/* ===== 功能入口 ===== */
.menu-card {
  margin: 24rpx 24rpx 0;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 48rpx;
}

.menu-name {
  flex: 1;
  margin-left: 24rpx;
  color: #222222;
  font-size: 28rpx;
  font-weight: 500;
}

.menu-arrow {
  flex-shrink: 0;
  color: #c9c9c9;
  font-size: 34rpx;
  line-height: 40rpx;
}

/* ===== 退出登录 ===== */
.logout-card {
  margin: 24rpx 24rpx 0;
  padding: 30rpx 0;
  text-align: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  color: #ff3d00;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

/* ===== 版本信息 ===== */
.version-tip {
  margin-top: 48rpx;
  text-align: center;
  color: #bcbcbc;
  font-size: 22rpx;
}
